# Application
NODE_ENV=development
PORT=3002

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# PostgreSQL Database
DATABASE_HOST=localhost
DATABASE_PORT=5434
DATABASE_USERNAME=aisle
DATABASE_PASSWORD=aisle_secret
DATABASE_NAME=aisle_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=documents

# S3 / MinIO Object Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_secret
S3_BUCKET=aisle-documents
S3_REGION=us-east-1

# LLM Providers (primary)
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# ─────────────────────────────────────────────────────────────────────────────
# CLIENT API KEYS — paste the three keys below (used as fallback / free-tier)
# ─────────────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=your-openrouter-api-key
MISTRAL_API_KEY=your-mistral-api-key
GEMINI_API_KEY=your-gemini-api-key
# ─────────────────────────────────────────────────────────────────────────────

# Default LLM Configuration
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# RAG Configuration
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5
